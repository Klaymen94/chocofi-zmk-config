#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_L 0

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
};

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE MINUS LSHIFT EQUAL SPACE KP_SLASH SLASH>; };

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        coma_semi: coma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp PERIOD>, <&kp COLON>, <&kp LA(COLON)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&hm LEFT_COMMAND SEMI>, <&kp APOSTROPHE>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&caron>;

            tapping-term-ms = <250>;
        };
    };

    combos {
        compatible = "zmk,combos";

        toggle_shift {
            bindings = <&caps_word>;
            key-positions = <16 13>;
            layers = <0 2 1 3 4>;
        };

        esc-combo {
            bindings = <&kp ESCAPE>;
            key-positions = <2 3>;
            timeout-ms = <30>;
            layers = <0 2 1 3 4>;
        };

        cmd_space {
            bindings = <&kp LG(SPACE)>;
            key-positions = <12 13>;
            layers = <0 1 3 2>;
        };

        cmb_tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
            layers = <0 2 1 3>;
        };
    };

    macros {
        caron: caron {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT &kp EQUAL>,
                <&macro_release>,
                <&kp LEFT_SHIFT &kp EQUAL>;

            label = "CARON";
        };

        zavinac: zavinac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(NUMBER_2)>;
            label = "ZAVINAC";
        };

        prehlasovane_a: prehlasovane_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>;
            label = "PREHLASOVANE_A";
        };

        emoji_select: emoji_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_COMMAND &kp LEFT_CONTROL &kp SPACE>;
            label = "EMOJI_SELECT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEF";
            bindings = <
  &kp Q           &kp W           &kp E               &kp R             &kp T        &kp Y                  &kp U              &kp I                &kp O            &kp P
  &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F  &kp G        &kp H                  &hm RIGHT_SHIFT J  &hm RIGHT_CONTROL K  &hm RIGHT_ALT L  &td0
  &kp Z           &kp X           &kp C               &kp V             &kp B        &kp N                  &kp M              &coma_semi           &dot_colon       &kp SLASH
                                  &kp LEFT_GUI        &lt 1 BACKSPACE   &kp SPACE    &mt RIGHT_COMMAND RET  &lt 2 BACKSPACE    &td2
            >;
        };

        num_layer {
            bindings = <
  &none               &kp LA(LEFT)  &kp UP_ARROW    &kp LA(RIGHT)      &kp LG(LS(Y))    &kp N1          &kp N7              &kp N8        &kp N9                 &none
  &kp LEFT_SHIFT      &kp LEFT      &kp DOWN_ARROW  &kp RIGHT          &kp LG(Y)        &kp SLASH       &hm RIGHT_SHIFT N4  &hm LCTRL N5  &hm LEFT_ALT NUMBER_6  &none
  &kp LG(LEFT_SHIFT)  &none         &kp LEFT_GUI    &kp LG(LC(SPACE))  &kp LG(LS(E))    &kp N0          &kp N1              &kp NUMBER_2  &kp NUMBER_3           &none
                                    &trans          &trans             &trans           &kp LEFT_SHIFT  &mo 3               &tog 4
            >;
        };

        sym_layer {
            bindings = <
  &none            &none  &none   &none          &none                &none                 &none                  &none   &none  &none
  &prehlasovane_a  &none  &none   &none          &none                &kp LA(LEFT_BRACKET)  &kp RA(RIGHT_BRACKET)  &none   &none  &none
  &none            &none  &none   &kp LESS_THAN  &kp DOUBLE_QUOTES    &none                 &none                  &none   &none  &none
                          &trans  &mo 3          &trans               &trans                &trans                 &trans
            >;
        };

        func_layer {
            bindings = <
  &kp F1        &kp F2         &kp F3        &kp F4      &kp F5              &kp F6       &kp F7        &kp F8           &kp F9  &kp F10
  &none         &emoji_select  &kp K_PREV    &kp C_NEXT  &kp C_PLAY_PAUSE    &kp C_MUTE   &kp C_VOL_DN  &kp C_VOLUME_UP  &none   &kp F11
  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_NXT  &bt BT_CLR          &none        &none         &none            &none   &kp F12
                               &sys_reset    &trans      &bootloader         &bootloader  &trans        &sys_reset
            >;
        };

        GAME_LAYER {
            label = "game";
            bindings = <
  &kp Q  &kp W  &kp E           &kp R            &kp T        &kp Y                  &kp U            &kp I       &kp O       &kp P
  &kp A  &kp S  &kp D           &kp F            &kp G        &kp H                  &kp J            &kp K       &kp L       &td0
  &kp Z  &kp X  &kp C           &kp V            &kp B        &kp N                  &kp M            &coma_semi  &dot_colon  &kp SLASH
                &kp LEFT_SHIFT  &lt 1 BACKSPACE  &kp SPACE    &mt RIGHT_COMMAND RET  &lt 2 BACKSPACE  &tog 4
            >;
        };
    };
};
